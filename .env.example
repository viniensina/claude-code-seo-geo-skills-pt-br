# WordPress REST API
# Crie um Application Password em: Usuários > Perfil > Application Passwords
WP_URL=https://seusite.com
# WP_USER é o nome de usuário (login) do WordPress. Só use o e-mail se ele for o
# seu login de fato — Application Passwords autenticam pelo user_login, não pelo e-mail.
WP_USER=seu-usuario-wp
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Unsplash (para a skill cover-image)
# Registre um app em: https://unsplash.com/developers
UNSPLASH_KEY=sua-chave-unsplash

# Opcionais da skill cover-image (branding e fontes da capa) — troque pelo seu visual.
# Se omitidos, o script escolhe um default por SO (Windows/Mac/Linux). Se a fonte não
# existir, cai na fonte padrão do PIL (texto pequeno) e avisa.
# COVER_BRAND=seusite.com
# Windows:
# COVER_FONT_BOLD=C:/Windows/Fonts/segoeuib.ttf
# COVER_FONT_REG=C:/Windows/Fonts/segoeui.ttf
# Linux (Debian/Ubuntu, pacote fonts-dejavu-core):
# COVER_FONT_BOLD=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
# COVER_FONT_REG=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# macOS:
# COVER_FONT_BOLD=/System/Library/Fonts/Supplemental/Arial Bold.ttf
# COVER_FONT_REG=/System/Library/Fonts/Supplemental/Arial.ttf
